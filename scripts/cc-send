#!/usr/bin/env python3
"""列出本机正在运行的 Claude Code 会话、给会话发消息、接收会话发来的消息（不新开会话）。

  cc-send --list                          列出本用户的活跃会话
  cc-send <目标> <消息>                   发一条消息；目标写标题 / 会话名 / 会话 id（前 8 位以上）/ pid，必须唯一命中
  cc-send --wait 30 <目标> <消息>         发完在对方的对话记录里等这条消息出现
  cc-send --ask 120 <目标> <消息>         发完等对方回信（开一个临时收件口作为回信地址），打印回信
  cc-send --recv [--timeout 600] [--once] 开一个常驻收件口并打印地址，收到的每条消息打印出来

消息经会话的收件 socket 投递，与 SendMessage 走同一入口，对方的收件控制照常生效。
不带 token、不声明权限级别；回信地址只写自己真实开的收件口。
以 bypassPermissions 运行的会话会先扣住消息等批准（VS Code / Cursor 里弹不出批准框，默认约 5 分钟后作废）。
消息行格式取自 Claude Code 2.1.329（peerProtocol 1），不是公开接口，升级后可能要改。
"""
import argparse
import glob
import json
import os
import re
import signal
import socket
import stat
import struct
import sys
import time
import uuid

HOME = os.path.expanduser(os.environ.get("CLAUDE_CONFIG_DIR", "~/.claude"))
UID = os.getuid()
SOCK_DIRS = [f"/run/user/{UID}/cc-socks", f"/tmp/cc-socks-{UID}", "/tmp/cc-socks"]


def alive(pid):
    try:
        return os.stat(f"/proc/{pid}").st_uid == UID
    except OSError:
        return False


def title_of(sid):
    paths = glob.glob(f"{HOME}/projects/*/{sid}.jsonl") if sid else []
    custom = ai = ""
    for path in paths:
        with open(path, errors="replace") as f:
            for line in f:
                if '"customTitle"' not in line and '"aiTitle"' not in line:
                    continue
                try:
                    d = json.loads(line)
                except ValueError:
                    continue
                custom = d.get("customTitle") or custom
                ai = d.get("aiTitle") or ai
    return custom or ai, (paths[0] if paths else "")


def sessions():
    found = {}
    for path in glob.glob(f"{HOME}/sessions/*.json"):
        try:
            d = json.load(open(path))
        except (OSError, ValueError):
            continue
        pid, sock = d.get("pid"), d.get("messagingSocketPath")
        if pid and sock and alive(pid) and os.path.exists(sock):
            found[pid] = dict(pid=pid, sid=d.get("sessionId", ""), name=d.get("name", ""),
                              status=d.get("status", ""), version=d.get("version", ""), sock=sock)
    for d in SOCK_DIRS:
        for sock in glob.glob(f"{d}/*.sock"):
            pid = os.path.basename(sock)[:-5]
            if pid.isdigit() and int(pid) not in found and alive(int(pid)):
                found[int(pid)] = dict(pid=int(pid), sid="", name="", status="", version="", sock=sock)
    for pid, s in found.items():
        try:
            argv = open(f"/proc/{pid}/cmdline", "rb").read().decode(errors="replace").split("\0")
        except OSError:
            argv = []
        line = " ".join(argv)
        m = re.search(r"--(?:resume|session-id)[= ]([0-9a-f-]{36})", line)
        if not s["sid"] and m:
            s["sid"] = m.group(1)
        m = re.search(r"--permission-mode[= ](\S+)", line)
        s["mode"] = m.group(1) if m else ""
        s["title"], s["log"] = title_of(s["sid"])
    return sorted(found.values(), key=lambda s: s["pid"])


def squash(text):
    return re.sub(r"\s+", "", text or "").lower()


def pick(target):
    hits = []
    for s in sessions():
        if target == str(s["pid"]) or squash(target) in (squash(s["title"]), squash(s["name"])) \
                or (len(target) >= 8 and s["sid"].startswith(target)):
            hits.append(s)
    if len(hits) != 1:
        sys.exit(f"目标“{target}”命中 {len(hits)} 个会话，未发送；用 --list 查看，改用 pid 或会话 id")
    return hits[0]


class Inbox:
    """自己的收件口：私有目录里的 unix socket，只接受同一系统用户的连接。"""

    def __init__(self):
        base = os.environ.get("XDG_RUNTIME_DIR") or ""
        self.dir = os.path.join(base, "cc-send") if base and os.path.isdir(base) and os.stat(base).st_uid == UID \
            else f"/tmp/cc-send-{UID}"
        os.makedirs(self.dir, mode=0o700, exist_ok=True)
        st = os.lstat(self.dir)
        if not stat.S_ISDIR(st.st_mode) or st.st_uid != UID or st.st_mode & 0o077:
            sys.exit(f"{self.dir} 不是本用户私有目录，拒绝在里面开收件口")
        self.path = os.path.join(self.dir, f"inbox-{os.getpid()}.sock")
        if os.path.lexists(self.path):
            os.unlink(self.path)
        self.srv = socket.socket(socket.AF_UNIX)
        self.srv.bind(self.path)
        os.chmod(self.path, 0o600)
        self.srv.listen(8)
        self.address = "uds:" + self.path

    def close(self):
        self.srv.close()
        if os.path.lexists(self.path):
            os.unlink(self.path)

    def messages(self, timeout=None):
        """逐条产出 (来源名, 回信地址, 正文, 原始类型)。"""
        end = None if timeout is None else time.time() + timeout
        while end is None or time.time() < end:
            self.srv.settimeout(1 if end is None else max(0.1, min(1, end - time.time())))
            try:
                conn, _ = self.srv.accept()
            except socket.timeout:
                continue
            with conn:
                conn.settimeout(30)
                uid = struct.unpack("3i", conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i")))[1]
                if uid != UID:
                    continue
                buf = b""
                try:
                    while len(buf) <= 1_100_000:
                        data = conn.recv(65536)
                        if not data:
                            break
                        buf += data
                except OSError:
                    pass
            for line in buf.split(b"\n"):
                if line.strip():
                    parsed = parse(line)
                    if parsed:
                        yield parsed


def parse(line):
    try:
        d = json.loads(line)
    except ValueError:
        return None
    if d.get("type") == "auth":
        return None
    content = (d.get("message") or {}).get("content")
    if isinstance(content, list):
        content = "\n".join(x.get("text", "") for x in content if isinstance(x, dict))
    content = content if isinstance(content, str) else json.dumps(d, ensure_ascii=False)
    m = re.match(r"\s*<cross-session-message([^>]*)>\n?(.*?)\n?</cross-session-message>\s*$", content, re.S)
    attrs = dict(re.findall(r'([\w-]+)="([^"]*)"', m.group(1))) if m else {}
    body = m.group(2) if m else content
    return (attrs.get("from-name") or "?", attrs.get("from") or d.get("from") or "", body, d.get("type", ""))


def show(msg):
    name, addr, body, kind = msg
    clean = re.sub(r"[\x00-\x08\x0b-\x1f\x7f]", "?", body)
    print(f"--- {time.strftime('%H:%M:%S')} 来自 {name}" + (f"（{addr}）" if addr else "") + ("" if kind == "user" else f" [{kind}]"))
    print(clean, flush=True)


def send(s, text, sender, reply=""):
    st = os.lstat(s["sock"])
    if not stat.S_ISSOCK(st.st_mode) or st.st_uid != UID:
        sys.exit("目标 socket 不是本用户的真实 socket，未发送")
    body = text.replace("</cross-session-message", "<\\/cross-session-message")
    name = re.sub(r'[<>"&\n\r]', " ", sender)
    origin = f'from="{reply}" ' if reply else ""
    msg_id = str(uuid.uuid4())
    line = json.dumps({"msgV": 1, "msg_id": msg_id, "type": "user",
                       "message": {"role": "user",
                                   "content": f'<cross-session-message {origin}from-name="{name}">\n{body}\n</cross-session-message>'},
                       "priority": "next", **({"from": reply} if reply else {})}, ensure_ascii=False)
    if len(line) > 1_000_000:
        sys.exit("消息过长，未发送")
    with socket.socket(socket.AF_UNIX) as c:
        c.settimeout(10)
        c.connect(s["sock"])
        c.sendall(line.encode() + b"\n")
        c.shutdown(socket.SHUT_WR)
        try:
            reply = c.recv(4096)
        except OSError:
            reply = b""
    if reply.strip():
        print("对方返回：", reply.decode(errors="replace").strip())
    return msg_id


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--list", action="store_true", help="列出活跃会话")
    ap.add_argument("--wait", type=int, default=0, metavar="秒", help="在对方对话记录里等消息出现")
    ap.add_argument("--ask", type=int, default=0, metavar="秒", help="发完等对方回信")
    ap.add_argument("--recv", action="store_true", help="开收件口，打印收到的消息")
    ap.add_argument("--timeout", type=int, default=0, metavar="秒", help="--recv 的时长，0 为一直开")
    ap.add_argument("--once", action="store_true", help="--recv 收到一条就退出")
    ap.add_argument("--from-name", default=f"cc-send script ({os.environ.get('USER', UID)}@{socket.gethostname()})")
    ap.add_argument("target", nargs="?")
    ap.add_argument("message", nargs="?")
    a = ap.parse_args()
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))  # 被终止时也走 finally，删掉收件口
    if a.list:
        rows = sessions()
        for s in rows:
            print(f"pid {s['pid']}  {s['status'] or '-':5}  mode={s['mode'] or '?'}  {s['sid'][:8] or '-':8}  "
                  f"name={s['name'] or '-'}  title={s['title'] or '-'}")
        if not rows:
            print("没有找到本用户的活跃会话")
        return
    if a.recv:
        box = Inbox()
        print(f"收件地址：{box.address}", flush=True)
        try:
            for msg in box.messages(a.timeout or None):
                show(msg)
                if a.once:
                    break
        except KeyboardInterrupt:
            pass
        finally:
            box.close()
        return
    if not a.target or not a.message:
        ap.error("要给出目标和消息，或用 --list / --recv")
    s = pick(a.target)
    if s["mode"] == "bypassPermissions":
        print("注意：对方以 bypassPermissions 启动，消息多半会被扣住等批准")
    size = os.path.getsize(s["log"]) if s["log"] else 0
    box = Inbox() if a.ask else None
    try:
        msg_id = send(s, a.message, a.from_name, box.address if box else "")
        print(f"已写入收件口：pid {s['pid']}  title={s['title'] or s['name']}  msg_id={msg_id}", flush=True)
        if box:
            for msg in box.messages(a.ask):
                show(msg)
                return
            print("等待时间内没有收到回信")
            return
    finally:
        if box:
            box.close()
    first = a.message.strip().split("\n")[0][:60]
    end = time.time() + a.wait
    while a.wait and s["log"] and time.time() < end:
        time.sleep(1)
        with open(s["log"], errors="replace") as f:
            f.seek(size)
            new = f.read()
        if first in new or json.dumps(first)[1:-1] in new:
            print("已出现在对方的对话记录里")
            return
    if a.wait:
        print("等待时间内没有在对方的对话记录里看到，不能确认送达")


if __name__ == "__main__":
    main()
